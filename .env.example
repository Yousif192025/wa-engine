# Existing Next.js dashboard configuration
NEXT_PUBLIC_BERRYLABS_API_URL=YOUR_BERRYLABS_API_URL
NEXT_PUBLIC_BERRYLABS_API_KEY=YOUR_BERRYLABS_API_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
PRISMA_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_DATA_NET_API_KEY"

# Standalone Baileys + Gemini support bot runtime. Set these only on the bot host.
NODE_ENV=production
PORT=8080
BOT_NAME=مساعد_المعهد
DEFAULT_LANGUAGE=ar
ENABLE_AI=true
ENABLE_GROUP_REPLY=false
MAX_HISTORY_MESSAGES=12
MAX_INPUT_CHARACTERS=5000
MAX_OUTPUT_CHARACTERS=3000
MAX_FILE_SIZE=8388608
REQUEST_TIMEOUT_MS=20000
MAX_RETRIES=2

# Gemini: server-side only; never expose this key in NEXT_PUBLIC_* variables.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Supabase: service-role key is server-side only; never expose it to browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Baileys session persistence. Generate the encryption value once with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Do not commit, log, or store the actual value in Supabase.
BAILEYS_AUTH_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_RANDOM_VALUE
BAILEYS_ACCOUNT_ID=default
BAILEYS_RECONNECT_DELAY_MS=5000

# Baileys WhatsApp pairing. Set both to enable Pairing Code flow:
# BAILEYS_USE_PAIRING_CODE=true
# BAILEYS_PHONE_NUMBER=+1234567890
BAILEYS_USE_PAIRING_CODE=false
BAILEYS_PHONE_NUMBER=

# User-facing temporary-failure fallback messages.
FALLBACK_MESSAGE_AR=عذرًا، أواجه مشكلة مؤقتة في خدمة الرد الذكي. يرجى المحاولة مرة أخرى لاحقًا.
FALLBACK_MESSAGE_EN=Sorry, I am having a temporary issue with the support service. Please try again later.
