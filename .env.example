# Existing Next.js dashboard configuration
NEXT_PUBLIC_BERRYLABS_API_URL=YOUR_BERRYLABS_API_URL
NEXT_PUBLIC_BERRYLABS_API_KEY=YOUR_BERRYLABS_API_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
PRISMA_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_DATA_NET_API_KEY"

# Standalone WhatsApp AI Support Bot runtime
NODE_ENV=development
PORT=8080
BOT_NAME=مساعد_المعهد
DEFAULT_LANGUAGE=ar
ENABLE_AI=true
ENABLE_GROUP_REPLY=false
MAX_HISTORY_MESSAGES=12
MAX_INPUT_CHARACTERS=5000
MAX_OUTPUT_CHARACTERS=3000
MAX_FILE_SIZE=8388608
REQUEST_TIMEOUT_MS=20000
MAX_RETRIES=2

# Gemini: server-side only; never expose this key in NEXT_PUBLIC_* variables.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Supabase: service-role key is server-side only; do not expose it to browsers.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Wassenger REST API and webhook authentication.
WASSENGER_API_URL=https://api.wassenger.com/v1
WASSENGER_API_KEY=YOUR_WASSENGER_API_KEY
WASSENGER_DEVICE_ID=YOUR_WASSENGER_DEVICE_ID
WEBHOOK_SHARED_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# User-facing temporary-failure fallback messages.
FALLBACK_MESSAGE_AR=عذرًا، أواجه مشكلة مؤقتة في خدمة الرد الذكي. يرجى المحاولة مرة أخرى لاحقًا.
FALLBACK_MESSAGE_EN=Sorry, I am having a temporary issue with the support service. Please try again later.
